# 前端环境变量配置
# 复制此文件为 .env 并修改配置

# API基础URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# 应用配置
VITE_APP_TITLE=知识库AI助手
VITE_APP_DESCRIPTION=企业级知识库智能问答系统

# 功能开关
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=false

# 第三方服务
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# 主题配置
VITE_PRIMARY_COLOR=#409EFF
VITE_SECONDARY_COLOR=#67C23A

# 分页配置
VITE_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100